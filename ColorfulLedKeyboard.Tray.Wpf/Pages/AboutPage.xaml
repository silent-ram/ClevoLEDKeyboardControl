<UserControl x:Class="ColorfulLedKeyboard.Tray.Wpf.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{DynamicResource DarkScrollViewer}"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,18,18,28" MaxWidth="832">
            <Border Style="{DynamicResource UiCard}">
                <StackPanel>
                    <TextBlock Text="ClevoLEDKeyboardControl" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock x:Name="AuthorText" Text="By silent-ram" FontSize="13" FontWeight="Bold"
                               Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="VersionText" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock x:Name="RuntimeText" FontSize="12"
                                   Foreground="{DynamicResource Brush.MutedText}" Margin="14,0,0,0" />
                        <TextBlock x:Name="CheckUpdateLink" Text="{DynamicResource str.menu.checkUpdate}"
                                   FontSize="12" Margin="14,0,0,0" Cursor="Hand"
                                   Foreground="{DynamicResource Brush.Primary}"
                                   MouseLeftButtonDown="CheckForUpdates" />
                        <TextBlock x:Name="UpdateBadgeText" FontSize="12" FontWeight="Bold" Margin="14,0,0,0"
                                   Cursor="Hand" Visibility="Collapsed"
                                   Foreground="{DynamicResource Brush.Error}"
                                   MouseLeftButtonDown="OpenUpdateChannels" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource str.about.tagline}" FontSize="12"
                               Foreground="{DynamicResource Brush.MutedText}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{DynamicResource str.about.repo}" Style="{DynamicResource UiButton}" Width="145" Margin="0,0,10,0"
                                Click="OpenRepository" />
                        <Button Content="{DynamicResource str.about.quark}" x:Name="QuarkButton" Style="{DynamicResource UiButton}" Width="126" Margin="0,0,10,0"
                                Click="OpenQuark" />
                        <Button Content="{DynamicResource str.about.issues}" Style="{DynamicResource UiButton}" Width="112"
                                Click="OpenIssues" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
