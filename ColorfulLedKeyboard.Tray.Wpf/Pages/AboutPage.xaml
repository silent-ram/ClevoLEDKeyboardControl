<UserControl x:Class="ColorfulLedKeyboard.Tray.Wpf.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{DynamicResource DarkScrollViewer}"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,18,18,28" MaxWidth="832">
            <!-- 身份区：名称 + 光谱签名 + 版本 + 入口 -->
            <Border Style="{DynamicResource UiCard}">
                <StackPanel>
                    <TextBlock Text="ClevoLEDKeyboardControl" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text}" />
                    <Rectangle Height="3" Width="148" HorizontalAlignment="Left" Margin="0,10,0,0"
                               Fill="{DynamicResource Brush.Spectrum}" RadiusX="1.5" RadiusY="1.5" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="VersionText" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock x:Name="RuntimeText" FontSize="12"
                                   Foreground="{DynamicResource Brush.MutedText}" Margin="14,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="面向 Clevo 兼容机型的键盘背光灯效控制程序。" FontSize="12"
                               Foreground="{DynamicResource Brush.MutedText}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="打开 GitHub 仓库" Style="{DynamicResource UiButton}" Width="145" Margin="0,0,10,0"
                                Click="OpenRepository" />
                        <Button Content="反馈问题" Style="{DynamicResource UiButton}" Width="112" Margin="0,0,10,0"
                                Click="OpenIssues" />
                        <Button Content="检查更新" Style="{DynamicResource UiButton}" Width="112"
                                Click="CheckForUpdates" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- 软件信息 -->
                <Border Grid.Column="0" Style="{DynamicResource UiCard}" Margin="0,0,7,14">
                    <StackPanel>
                        <TextBlock Text="软件信息" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8" />
                        <TextBlock Text="运行环境" FontSize="11" Foreground="{DynamicResource Brush.MutedText}" />
                        <TextBlock x:Name="RuntimeValue" FontSize="12" Foreground="{DynamicResource Brush.Text}"
                                   Margin="0,2,0,8" />
                        <TextBlock Text="安装位置" FontSize="11" Foreground="{DynamicResource Brush.MutedText}" />
                        <TextBlock x:Name="InstallPathValue" FontSize="12" Foreground="{DynamicResource Brush.Text}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <!-- 开源与改进 -->
                <Border Grid.Column="1" Style="{DynamicResource UiCard}" Margin="7,0,0,14">
                    <StackPanel>
                        <TextBlock Text="开源与改进" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8" />
                        <TextBlock Text="本软件以 GPL-3.0 协议开源，复制与修改需遵循同一协议。"
                                   FontSize="12" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                        <Button Content="查看许可证" Style="{DynamicResource UiButton}" Width="112"
                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenLicense" />
                        <TextBlock x:Name="ImprovementStatus" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.MutedText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
