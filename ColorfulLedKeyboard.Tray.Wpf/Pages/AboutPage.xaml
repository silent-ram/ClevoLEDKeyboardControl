<UserControl x:Class="ColorfulLedKeyboard.Tray.Wpf.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{DynamicResource DarkScrollViewer}"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,18,18,28" MaxWidth="832" HorizontalAlignment="Left">
            <Border Style="{DynamicResource UiCard}">
                <StackPanel>
                    <TextBlock Text="关于" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                    <TextBlock Text="ClevoLEDKeyboardControl" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,10,0,0" />
                    <Rectangle Height="3" Width="148" HorizontalAlignment="Left" Margin="0,8,0,0"
                               Fill="{DynamicResource Brush.Spectrum}" RadiusX="1.5" RadiusY="1.5" />
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource Brush.MutedText}" Margin="0,8,0,0" />
                    <TextBlock Text="面向 Clevo 兼容机型的键盘背光灯效控制程序。" FontSize="12"
                               Foreground="{DynamicResource Brush.Text}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="打开 GitHub 仓库" Style="{DynamicResource UiButton}" Width="145" Margin="0,0,10,0"
                                Click="OpenRepository" />
                        <Button Content="反馈问题" Style="{DynamicResource UiButton}" Width="112" Click="OpenIssues" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
