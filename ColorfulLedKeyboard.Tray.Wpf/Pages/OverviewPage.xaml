<UserControl x:Class="ColorfulLedKeyboard.Tray.Wpf.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{DynamicResource DarkScrollViewer}"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,18,18,28" MaxWidth="832" HorizontalAlignment="Left">
            <UniformGrid Columns="3">
                <Border Style="{DynamicResource UiCard}" Margin="0,0,12,14">
                    <StackPanel>
                        <TextBlock Text="当前模式" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock x:Name="ModeValue" Text="—" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="应用正在使用的基础灯效" FontSize="11.5" Foreground="{DynamicResource Brush.MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource UiCard}" Margin="0,0,12,14">
                    <StackPanel>
                        <TextBlock Text="最终亮度" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock x:Name="BrightnessValue" Text="—" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="BrightnessHint" Text="等待服务计算最终输出" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource UiCard}">
                    <StackPanel>
                        <TextBlock Text="运行状态" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock x:Name="ServiceValue" Text="—" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Success}" Margin="0,6,0,0" />
                        <TextBlock Text="服务与厂商灯控组件" FontSize="11.5" Foreground="{DynamicResource Brush.MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{DynamicResource UiCard}">
                <StackPanel>
                    <TextBlock Text="当前场景" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="命中规则" Foreground="{DynamicResource Brush.MutedText}" VerticalAlignment="Center" />
                        <TextBlock x:Name="RuleValue" Grid.Row="0" Grid.Column="1" Text="—" Foreground="{DynamicResource Brush.Text}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="播放器" Foreground="{DynamicResource Brush.MutedText}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlayerValue" Grid.Row="1" Grid.Column="1" Text="—" Foreground="{DynamicResource Brush.Text}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Text="事件反馈" Foreground="{DynamicResource Brush.MutedText}" VerticalAlignment="Center" />
                        <TextBlock x:Name="EventsValue" Grid.Row="2" Grid.Column="1" Text="—" Foreground="{DynamicResource Brush.Text}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource UiCard}">
                <StackPanel>
                    <TextBlock Text="快捷操作" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="OpenLighting" Content="打开灯效设置" Style="{DynamicResource UiButton}" Width="130" Margin="0,0,10,0" />
                        <Button x:Name="OpenMusic" Content="打开音乐模式" Style="{DynamicResource UiButton}" Width="130" Margin="0,0,10,0" />
                        <Button x:Name="OpenAutomation" Content="管理场景自动化" Style="{DynamicResource UiButton}" Width="145" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
